print("----- Task 1 Output -----")
def sequential_search(arr, target):
    comparisons = 0
    
    for i in range(len(arr)):
        comparisons += 1
        
        if arr[i] == target:
            return i, comparisons   # return index and comparisons
    
    return -1, comparisons          # if not found


# Example
arr = [23, 45, 12, 67, 89, 34, 56]
target = 67

index, comparisons = sequential_search(arr, target)

print("List:", arr)
print("Searching for", target, "using Sequential Search")

if index != -1:
    print("Found at index", index)
else:
    print("Element not found")

print("Number of comparisons:", comparisons)

print("----- Task 2 Output -----")
def binary_search_recursive(arr, left, right, target, comparisons=0):
    
    if left > right:
        return -1, comparisons
    
    mid = (left + right) // 2
    comparisons += 1
    
    if arr[mid] == target:
        return mid, comparisons
    
    elif arr[mid] < target:
        return binary_search_recursive(arr, mid+1, right, target, comparisons)
    
    else:
        return binary_search_recursive(arr, left, mid-1, target, comparisons)


# Example
arr = [12, 23, 34, 45, 56, 67, 89]
target = 67

index, comparisons = binary_search_recursive(arr, 0, len(arr)-1, target)

print("Sorted List:", arr)
print("Searching for", target, "using Recursive Binary Search")

if index != -1:
    print("Found at index", index)
else:
    print("Element not found")

print("Number of comparisons:", comparisons)
